# ASP.NET / authentication
SUPER_SECRET_KEY=
API_KEY_SECRET=
PASSWORD_HASH_WORK_FACTOR=11

# Database
MYSQL_ROOT_PASSWORD=
ConnectionStrings__DefaultConnection=
DEFAULT_CONNECTION_STRING=
DB_PASSWORD=

# Reservation service integration
# Reservations live in reservation-service. The main backend uses this URL for the compatible GET /api/rooms/top proxy.
ReservationService__BaseUrl=http://host.docker.internal:8081
ReservationService__TopRoomsPath=/api/reservations/top-rooms
ReservationService__TimeoutSeconds=10

# AWS / SQS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
SQS_AUDIT_QUEUE_URL=https://example.com/workly-audit
SKIP_AUDIT_QUEUE=false
SNS_INVITATION_TOPIC_ARN=arn:aws:sns:us-east-1:ACCOUNT_ID:invitation-topic
SKIP_INVITATION_NOTIFICATION=false

# Identity service integration
IDENTITY_SERVICE_BASE_URL=http://host.docker.internal:5100
IdentityService__BaseUrl=http://host.docker.internal:5100
IdentityService__ApiKeyValidationPath=/api/api-keys/validate
IdentityService__UsersByAreaPath=/api/users
IdentityService__TimeoutSeconds=10

# New Relic
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APP_NAME=workly-api
