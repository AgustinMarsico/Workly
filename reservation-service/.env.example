# ASP.NET
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080

# Reservation service HTTP port
RESERVATION_SERVICE_PORT=8081

# MySQL container
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=workly_reservations
MYSQL_USER=workly_user
MYSQL_PASSWORD=
MYSQL_HOST_PORT=3307
MYSQL_CONTAINER_PORT=3306

# Connection string used by reservation-service
CONNECTION_STRING=
ConnectionStrings__DefaultConnection=
DEFAULT_CONNECTION_STRING=
DB_PASSWORD=

# Main/backend service integration for docker-compose variable substitution
# The main backend owns rooms, companies and areas. Identity owns API keys.
MAIN_SERVICE_BASE_URL=http://host.docker.internal:5000
MAIN_SERVICE_TIMEOUT_SECONDS=10
IDENTITY_SERVICE_BASE_URL=http://host.docker.internal:5100
IDENTITY_SERVICE_API_KEY_VALIDATION_PATH=/api/api-keys/validate
IDENTITY_SERVICE_TIMEOUT_SECONDS=10

# Main/backend service integration keys read by .NET configuration when loading .env directly
MainService__BaseUrl=http://host.docker.internal:5000
MainService__TimeoutSeconds=10
IdentityService__BaseUrl=http://host.docker.internal:5100
IdentityService__ApiKeyValidationPath=/api/api-keys/validate
IdentityService__TimeoutSeconds=10

# JWT shared secret for local development
SUPER_SECRET_KEY=

# AWS / SNS reservation notifications
AWS_REGION=us-east-1
SNS_RESERVATION_TOPIC_ARN=arn:aws:sns:us-east-1:ACCOUNT_ID:notification-topic
SQS_AUDIT_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/ACCOUNT_ID/audit-events-queue.fifo
SKIP_AUDIT_QUEUE=false
SKIP_RESERVATION_NOTIFICATION=false
