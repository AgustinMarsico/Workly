ASPNETCORE_ENVIRONMENT=Development

# Must match the shared JWT secret configured in the central private .env.
SUPER_SECRET_KEY=

# Supply private SQL Server credentials before using the standalone Compose.
SA_PASSWORD=
AUDIT_DB_APP_USERNAME=audit_user
AUDIT_DB_APP_PASSWORD=
ConnectionStrings__AuditMigrationDatabase=
ConnectionStrings__AuditDatabase=

# AWS SQS.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
SQS_AUDIT_QUEUE_URL=
SKIP_AUDIT_QUEUE=false

API_KEY_SECRET=
