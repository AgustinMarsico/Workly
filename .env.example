# Sólo desarrollo local. Generar .env con: python3 scripts/init-local-env.py
# No usar estos secretos ni los usuarios seed en producción.
COMPOSE_PROJECT_NAME=workly
ASPNETCORE_ENVIRONMENT=Development

# Secretos generados. No completar esta plantilla con valores reales.
SUPER_SECRET_KEY=
INTERNAL_SERVICE_KEY=
API_KEY_SECRET=
COMPANY_DB_ROOT_PASSWORD=
COMPANY_DB_PASSWORD=
IDENTITY_DB_ROOT_PASSWORD=
IDENTITY_DB_PASSWORD=
ROOMS_DB_ROOT_PASSWORD=
ROOMS_DB_PASSWORD=
RESERVATION_DB_ROOT_PASSWORD=
RESERVATION_DB_PASSWORD=
AUDIT_DB_SA_PASSWORD=
AUDIT_DB_APP_PASSWORD=

# Bases independientes. No se publican sus puertos al host.
COMPANY_DB_NAME=worklydb
IDENTITY_DB_NAME=workly_identity
ROOMS_DB_NAME=workly_rooms
RESERVATION_DB_NAME=workly_reservations
MYSQL_APP_USER=workly
AUDIT_DB_NAME=workly_audit
AUDIT_DB_APP_USERNAME=audit_user

# Puertos publicados sólo en 127.0.0.1.
COMPANY_PORT=5000
IDENTITY_PORT=5100
ROOMS_PORT=5300
RESERVATION_PORT=8081
AUDIT_PORT=5151
FRONTEND_PORT=8080

# URLs públicas usadas por el navegador (no nombres internos de contenedores).
# Si se modifica un puerto, actualizar también su URL pública y reconstruir frontend.
PUBLIC_COMPANY_API_URL=http://localhost:5000
PUBLIC_IDENTITY_API_URL=http://localhost:5100
PUBLIC_ROOMS_API_URL=http://localhost:5300
PUBLIC_RESERVATION_API_URL=http://localhost:8081
PUBLIC_AUDIT_API_URL=http://localhost:5151

# Modo local sin AWS ni envío de correos. El worker Notification no se levanta.
SKIP_AUDIT_QUEUE=true
SKIP_INVITATION_NOTIFICATION=true
SKIP_RESERVATION_NOTIFICATION=true
